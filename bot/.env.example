# ── Datos ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@host:5432/fisio1
# Solo para `npm run importar` (base legada del workflow n8n, SOLO lectura)
IMPORT_SOURCE_URL=

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Embeddings (RAG) ────────────────────────────────────────────────────────
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Chatwoot (hostname interno de la red dokploy) ───────────────────────────
CHATWOOT_URL=http://fisio-chatwoot:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_TOKEN=
# Secreto de la ruta del webhook: /webhook/chatwoot/<WEBHOOK_SECRET>
WEBHOOK_SECRET=cambiame

# ── Evolution API (instancia propia) ────────────────────────────────────────
EVOLUTION_URL=http://fisio-evolution:8080
EVOLUTION_INSTANCE=
EVOLUTION_TOKEN=

# ── Google Calendar (service account) ───────────────────────────────────────
# UNA sola variable, con dos formas válidas:
#   - ruta al fichero descargado:  ./fisios-serviceaccount.json   (cómodo en local)
#   - el JSON entero en UNA línea: {"type":"service_account",...}  (en Dokploy)
# Un .env no admite valores multilínea: si pegas el JSON, que sea todo en una línea.
GOOGLE_SERVICE_ACCOUNT=

# ── STT opcional (endpoint compatible OpenAI) ───────────────────────────────
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ── Operación ────────────────────────────────────────────────────────────────
PORT=3000
ADMIN_TOKEN=cambiame
DRY_RUN=true                      # true: el agente razona pero las escrituras se simulan
RECORDATORIOS_DRY_RUN=true        # true: los recordatorios solo se loguean
