# Base de datos (fisio1, por hostname interno de la red dokploy)
DATABASE_URL=postgresql://user:password@host:5432/fisio1

# Auth - superadmin hardcodeado
SUPERADMIN_EMAIL=admin@clinica.com
SUPERADMIN_PASSWORD=cambia_esto_en_produccion

# JWT secret (genera uno con: openssl rand -base64 32)
JWT_SECRET=tu_jwt_secret_aqui

# Uploads
UPLOAD_DIR=/app/uploads

# RAG (ingesta de documentos: mismo proveedor que el bot)
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# Simulador (el bot, por hostname interno; ADMIN_TOKEN del bot)
BOT_URL=http://fisio-bot:3000
BOT_ADMIN_TOKEN=
